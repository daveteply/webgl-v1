{
  "name": "Rikkle",
  "short_name": "Rikkle",
  "description": "Rikkle is an immersive 3D cylindrical puzzle matching game. Rotate cylinder rings left or right to line up 3 or more matching colors or symbols vertically, horizontally, or in L-shapes, and tap to clear them, score points, and earn bonus moves!",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["games", "puzzle"],
